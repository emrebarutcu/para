// cashfollow.app — Cloudflare Workers Builds (Worker adı: para). main'e her birleştirmede yayınlanır.
// Statik site kök dizinden sunulur; yalnızca MCP adresleri ve /api/kur Worker kodundan geçer (mcp/worker.js).
{
  "name": "para",
  "main": "mcp/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/api/*", "/.well-known/oauth-protected-resource*"]
  }
}
